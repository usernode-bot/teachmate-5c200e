{
  "description": "AI lesson plans, quizzes and grading for K-12 teachers",
  "icon": {
    "image": "brand/icon.png",
    "emoji": "🍎"
  },
  "secrets": [],
  "llm": {
    "purpose": "Writes lesson plans and quizzes, and reads answer sheet photos to suggest marks",
    "suggested_daily_cap_cents": 200
  },
  "tests": [
    { "name": "Lessons, empty account", "path": "/", "expectText": "No lesson plans yet" },
    { "name": "Lessons demo", "id": "lessons.demo", "path": "/?demo=1", "expectText": "Staging demo", "visual": true, "impact": ["public/**", "styles/**", "server.js", "lib/**"] },
    { "name": "Lesson form: one sideways subject row, every subject coloured, sticky Write button", "path": "/", "expectSelector": "section:has(#l-subject-chips.chip-row > .chip.s-loc ~ .chip.s-other:last-child):has(.form-foot #l-write)" },
    { "name": "Quizzes demo", "path": "/?demo=1#/quizzes", "expectText": "Water cycle quiz" },
    { "name": "Grade form", "path": "/?demo=1#/grade", "expectSelector": "#grade-form" },
    { "name": "Scores demo", "path": "/?demo=1#/scores", "expectText": "Room 12" },
    { "name": "Scores, empty account", "path": "/#/scores", "expectText": "No scores yet" }
    ,
    {
      "id": "home.logo",
      "name": "Home shows the TeachMate logo mark",
      "path": "/",
      "expectSelector": "img[src='/logo.svg']",
      "expectText": "TeachMate",
      "visual": true,
      "impact": ["public/index.html", "public/logo.svg", "styles/tailwind-input.css", "tailwind.config.js", "brand/**"]
    }
  ],
  "visibility": {
    "build": "public",
    "view": "public"
  }
}
